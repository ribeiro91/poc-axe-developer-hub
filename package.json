{
  "name": "modern-ui-frontend",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "node esbuild.build.mjs && node cmp.esbuild.mjs && node scripts/copy-resources.js && node scripts/copy-filter-v2.js && clientlib",
    "build-storybook": "npm run register-partial && cross-env NODE_OPTIONS='--openssl-legacy-provider --max_old_space_size=32768' storybook build",
    "dev": "npm run build",
    "lint": "eslint src",
    "prettier": "prettier --write src",
    "prod": "cross-env NODE_ENV=prod npm run build",
    "sanity": "npm run prettier && npm run lint",
    "start": "vite --port 5050 --open",
    "storybook": "cross-env NODE_ENV=dev concurrently \"node cmp.esbuild.mjs\" \"npm run register-partial-watch\" \"cross-env NODE_OPTIONS='--openssl-legacy-provider' storybook dev -p 6006\"",
    "register-partial-watch": "nodemon --watch src --ext html .storybook/registerPartials.js",
    "register-partial": "node .storybook/registerPartials.js",
    "test": "PLINKO=true jest --update-snapshot --silent && jest",
    "testone": "PLINKO=true jest --update-snapshot --silent $npm_config_template && jest $npm_config_template",
    "homesetup": "node home.setup.js",
    "test:accessibility": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@axe-core/watcher": "^3.21.0",
    "@babel/core": "^7.19.3",
    "@mdx-js/react": "^1.6.22",
    "@playwright/test": "^1.53.2",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/addon-mdx-gfm": "^8.0.0",
    "@storybook/addon-themes": "^8.6.12",
    "@storybook/addons": "^7.6.17",
    "@storybook/blocks": "^8.0.0",
    "@storybook/cli": "^8.0.0",
    "@storybook/html": "^8.0.0",
    "@storybook/html-vite": "^8.0.0",
    "@storybook/testing-library": "^0.2.2",
    "aem-clientlib-generator": "^1.8.0",
    "autoprefixer": "^10.4.12",
    "axe-core": "^4.6.1",
    "babel-loader": "^8.2.5",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.15.11",
    "esbuild-plugin-less": "^1.1.9",
    "esbuild-style-plugin": "^1.6.0",
    "eslint": "^8.25.0",
    "eslint-config-eslint": "^7.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-semistandard": "^17.0.0",
    "eslint-plugin-jest": "^27.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-storybook": "^0.6.15",
    "handlebars": "^4.7.7",
    "jest-image-snapshot": "^5.2.0",
    "less": "^4.1.3",
    "nodemon": "^3.0.1",
    "playwright": "^1.30.0",
    "postcss": "^8.4.18",
    "prettier": "^2.7.1",
    "puppeteer": "^18.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semistandard": "^16.0.1",
    "shelljs": "^0.8.5",
    "standard": "^17.0.0",
    "storybook": "^8.0.0",
    "storybook-addon-rtl": "^1.1.0",
    "terser": "^5.15.1",
    "vite": "^3.1.8",
    "vite-plugin-chunk-split": "^0.4.1",
    "vite-plugin-handlebars": "^1.6.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-html-template": "^1.1.5",
    "vite-plugin-restart": "^0.2.0",
    "vite-plugin-turbosnap": "^1.0.1"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "testTimeout": 30000
  },
  "dependencies": {
    "@popperjs/core": "^2.11.6",
    "aos": "^3.0.0-beta.6",
    "bootstrap": "^5.3.3",
    "handlebars-to-jsx": "^0.1.5",
    "i18next": "^22.4.9",
    "i18next-browser-languagedetector": "^7.0.1",
    "jquery": "^3.7.1",
    "jquery-i18next": "^1.2.1",
    "swiper": "^11.0.6",
    "video.js": "^8.3.0",
    "videojs-playlist": "^5.1.1",
    "videojs-playlist-ui": "^5.0.0"
  },
  "overrides": {
    "@mdx-js/react": {
      "react": "^18.2.0",
      "react-dom": "^18.2.0"
    }
  }
}
